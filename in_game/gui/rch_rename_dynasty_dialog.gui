window = {
	name = "rch_rename_dynasty_dialog"
	parentanchor = center
	allow_outside = yes
	size = { 400 300 }

	vbox = {
		block "msg_size" {
			minimumsize = { 600 300 }
			maximumsize = { 600 300 }
		}
		set_parent_size_to_minimum = yes
		using = snd_UI_popup_show

		vbox = {
			using = layoutpolicy_expanding
			bottomtotop = yes

			vbox = {
				margin = {5 15}
				spacing = 10
				using = layoutpolicy_expanding
				using = bg_age_event_inner
				using = bg_age_event_frame


				widget = {
					allow_outside = yes

					block "desc_spacing" {
						size = { 1 1 }
					}
				}

				vbox = {
					layoutpolicy_horizontal = expanding
					margin = {30 0}
					block "message_template_content" {
						hbox = {
							layoutpolicy_horizontal = expanding
							margin = {5 0}
							using = message_text_box_background
							visible = yes
							# Slot 1
							editbox_single = {
								size = { 300 30 }
								visible = "[GetPlayer.HasVariable('rch_renaming_dynasty_1')]"

								blockoverride "editbox_label" {
									text = "RCH_DYNASTY_EDITBOX_DEFAULT"
								}

                                blockoverride "editbox_properties" {
                                    name = "new_name"
                                    tooltipwidget = {
                                        LeftClickButtonTooltip = {
                                            blockoverride "onclick_text" { text = "RCH_EDIT_DYNASTY_NAME" }
                                        }
                                    }
                                    # RCH: Save the text to a variable every time you type
                                    # ontextchanged = "[SelectLocalization(GetVariableSystem.Exists('rch_renaming_dynasty_1',GetVariableSystem.Set('rch_new_dynasty_name_1', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self)), GetVariableSystem.Set('rch_new_dynasty_name_2', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self)))]"
									ontextchanged = "[GetVariableSystem.Set('rch_new_dynasty_name_1', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"

                                    maxcharacters = 42
                                }
							}
							# Slot 2
							editbox_single = {
								size = { 300 30 }
								visible = "[GetPlayer.HasVariable('rch_renaming_dynasty_2')]"
								blockoverride "editbox_label" {
									text = "RCH_DYNASTY_EDITBOX_DEFAULT"
								}
								blockoverride "editbox_properties" {
									name = "new_name"
									tooltipwidget = {
										LeftClickButtonTooltip = {
											blockoverride "onclick_text" { text = "RCH_EDIT_DYNASTY_NAME" }
										}
									}
									ontextchanged = "[GetVariableSystem.Set('rch_new_dynasty_name_2', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
									maxcharacters = 42
								}
							}
							# Slot 3
							editbox_single = {
								size = { 300 30 }
								visible = "[GetPlayer.HasVariable('rch_renaming_dynasty_3')]"
								blockoverride "editbox_label" {
									text = "RCH_DYNASTY_EDITBOX_DEFAULT"
								}
								blockoverride "editbox_properties" {
									name = "new_name"
									tooltipwidget = {
										LeftClickButtonTooltip = {
											blockoverride "onclick_text" { text = "RCH_EDIT_DYNASTY_NAME" }
										}
									}
									ontextchanged = "[GetVariableSystem.Set('rch_new_dynasty_name_3', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
									maxcharacters = 42
								}
							}
							# Slot 4
							editbox_single = {
								size = { 300 30 }
								visible = "[GetPlayer.HasVariable('rch_renaming_dynasty_4')]"
								blockoverride "editbox_label" {
									text = "RCH_DYNASTY_EDITBOX_DEFAULT"
								}
								blockoverride "editbox_properties" {
									name = "new_name"
									tooltipwidget = {
										LeftClickButtonTooltip = {
											blockoverride "onclick_text" { text = "RCH_EDIT_DYNASTY_NAME" }
										}
									}
									ontextchanged = "[GetVariableSystem.Set('rch_new_dynasty_name_4', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
									maxcharacters = 42
								}
							}
							# Slot 5
							editbox_single = {
								size = { 300 30 }
								visible = "[GetPlayer.HasVariable('rch_renaming_dynasty_5')]"
								blockoverride "editbox_label" {
									text = "RCH_DYNASTY_EDITBOX_DEFAULT"
								}
								blockoverride "editbox_properties" {
									name = "new_name"
									tooltipwidget = {
										LeftClickButtonTooltip = {
											blockoverride "onclick_text" { text = "RCH_EDIT_DYNASTY_NAME" }
										}
									}
									ontextchanged = "[GetVariableSystem.Set('rch_new_dynasty_name_5', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
									maxcharacters = 42
								}
							}
							# Slot 6
							editbox_single = {
								size = { 300 30 }
								visible = "[GetPlayer.HasVariable('rch_renaming_dynasty_6')]"
								blockoverride "editbox_label" {
									text = "RCH_DYNASTY_EDITBOX_DEFAULT"
								}
								blockoverride "editbox_properties" {
									name = "new_name"
									tooltipwidget = {
										LeftClickButtonTooltip = {
											blockoverride "onclick_text" { text = "RCH_EDIT_DYNASTY_NAME" }
										}
									}
									ontextchanged = "[GetVariableSystem.Set('rch_new_dynasty_name_6', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
									maxcharacters = 42
								}
							}
							# Slot 7
							editbox_single = {
								size = { 300 30 }
								visible = "[GetPlayer.HasVariable('rch_renaming_dynasty_7')]"
								blockoverride "editbox_label" {
									text = "RCH_DYNASTY_EDITBOX_DEFAULT"
								}
								blockoverride "editbox_properties" {
									name = "new_name"
									tooltipwidget = {
										LeftClickButtonTooltip = {
											blockoverride "onclick_text" { text = "RCH_EDIT_DYNASTY_NAME" }
										}
									}
									ontextchanged = "[GetVariableSystem.Set('rch_new_dynasty_name_7', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
									maxcharacters = 42
								}
							}
							# Slot 8
							editbox_single = {
								size = { 300 30 }
								visible = "[GetPlayer.HasVariable('rch_renaming_dynasty_8')]"
								blockoverride "editbox_label" {
									text = "RCH_DYNASTY_EDITBOX_DEFAULT"
								}
								blockoverride "editbox_properties" {
									name = "new_name"
									tooltipwidget = {
										LeftClickButtonTooltip = {
											blockoverride "onclick_text" { text = "RCH_EDIT_DYNASTY_NAME" }
										}
									}
									ontextchanged = "[GetVariableSystem.Set('rch_new_dynasty_name_8', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
									maxcharacters = 42
								}
							}
							# Slot 9
							editbox_single = {
								size = { 300 30 }
								visible = "[GetPlayer.HasVariable('rch_renaming_dynasty_9')]"
								blockoverride "editbox_label" {
									text = "RCH_DYNASTY_EDITBOX_DEFAULT"
								}
								blockoverride "editbox_properties" {
									name = "new_name"
									tooltipwidget = {
										LeftClickButtonTooltip = {
											blockoverride "onclick_text" { text = "RCH_EDIT_DYNASTY_NAME" }
										}
									}
									ontextchanged = "[GetVariableSystem.Set('rch_new_dynasty_name_9', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
									maxcharacters = 42
								}
							}
							# Slot 10
							editbox_single = {
								size = { 300 30 }
								visible = "[GetPlayer.HasVariable('rch_renaming_dynasty_10')]"
								blockoverride "editbox_label" {
									text = "RCH_DYNASTY_EDITBOX_DEFAULT"
								}
								blockoverride "editbox_properties" {
									name = "new_name"
									tooltipwidget = {
										LeftClickButtonTooltip = {
											blockoverride "onclick_text" { text = "RCH_EDIT_DYNASTY_NAME" }
										}
									}
									ontextchanged = "[GetVariableSystem.Set('rch_new_dynasty_name_10', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
									maxcharacters = 42
								}
							}
						}
					}
				}

				hbox = {
					margin = { 0 10 }
					spacing = 50

                    # RCH: Debug Text
                    # text_single = {
                    #     raw_text = "TEXT: [GetVariableSystem.Get('rch_new_dynasty_name_1')] PLAYER: [GetPlayer.GetTag] TARGET: [GetVariableSystem.Get('rch_dynasty_to_rename')]"
                    #     align = center
                    #     default_format = "#low"
                    # }
					# text_single = {
					# 	raw_text = "COMMAND: [Concatenate( 'effect c:', Concatenate( GetPlayer.GetTag, ' = { rch_rename_dynasty = yes }' ) )]"
					# 	align = center
					# 	default_format = "#low"
					# }
					# text_single = {
					# 	raw_text = "1: [GetPlayer.HasVariable('rch_renaming_dynasty_1')] 2: [GetPlayer.HasVariable('rch_renaming_dynasty_2')]"
					# 	align = center
					# 	default_format = "#low"
					# }
					block "message_template_buttons" {
						button_regular_diamond = {
							name = "decline_button"
							tooltip_enabled = no
							text = "MESSAGEPOPUP_DECLINE"
							using = button_resize_to_fit_text
							using = snd_UI_close

							block "decline_title" {
								text = "RCH_CLOSE_BUTTON"
							}

							# block "decline_input_action" {
							onclick = "[ExecuteConsoleCommand('GUI.ClearWidgets rch_rename_dynasty_dialog')]"
							# }
						}

                        button_regular_diamond = {
                            enabled = yes
                            name = "accept_button"
                            tooltip_enabled = no
                            text = "RCH_CHANGE_THE_NAME"
                            using = button_resize_to_fit_text
                            using = snd_UI_popup_confirm

                            # RCH: Rename the dynasty
							onclick = "[ExecuteConsoleCommand( Concatenate( 'effect c:', Concatenate( GetPlayer.GetTag, ' = { rch_rename_dynasty = yes }' ) ) )]"
                            # Close the window
							onclick = "[ExecuteConsoleCommand('GUI.ClearWidgets rch_rename_dynasty_dialog')]"

                            input_action = "confirm"
                            use_global_input_instance = yes
                        }
					}
				}
			}

			hbox = {

				using = bg_age_event_title
				layoutpolicy_horizontal = expanding

				blockoverride "bg_event_title_texture" {
					texture = "gfx/interface/component_tiles/bg_big_round_corners_up.dds"
					texture_density = 2
					spriteType = corneredstretched
					spriteBorder = { 40 40 }
					margin = {3 0}
					margin_bottom = -2
				}

				widget = {
					layoutpolicy_vertical = expanding
					size = {5 -1}

					AgeEventDecorationTop = {
						size = {64 52}
						position = { -10 -2 }
						parentanchor = left|top
						widgetanchor = top
					}

					AgeEventDecorationTop2 = {
						parentanchor = left|bottom
						position = {-4 15}
						mirror = horizontal
					}
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 40 20 }
					spacing = 15

					block "message_decoration_left" {}

					block "message_title_content" {
						hbox = {
							vbox = {
								textbox = {
									using = text_multi_template

									autoresize = yes

									default_format = "#yellow_titles"
									fontsize = 22
									align = center|nobaseline
									text = "RCH_CHANGE_DYNASTY_NAME_TITLE"
								}

								textbox = {
									using = text_multi_template

									name = "subtitle"

									autoresize = yes
									fontsize = 19
									default_format = "#subtle_name"
									align = center
									text = "RCH_CHANGE_DYNASTY_NAME_SUBTITLE"
								}
							}
						}
					}

					block "message_decoration_right" {}
				}

				widget = {
					layoutpolicy_vertical = expanding
					size = {5 -1}

					AgeEventDecorationTop = {
						size = {64 52}
						position = { -53 -2 }
						parentanchor = right|top
						widgetanchor = top
						mirror = horizontal
					}

					AgeEventDecorationTop2 = {
						parentanchor = right|bottom
						position = {4 15}
					}
				}
			}
		}
	}

	widget = {
		ignore_layout = yes
		allow_outside = yes
		parentanchor = top|right
		position = {-10 5}
		size = {55 55}

		# Avoiding using cancel input action in go-to button
		button_close_alt = {
			name = "dummy_button"
			tooltip_enabled = no
			parentanchor = left|top
			position = {25 20}

			size = { 22 22 }
			using = bg_circle

			input_action = "close_window"
			use_global_input_instance = yes
			onclick = "[ExecuteConsoleCommand('GUI.ClearWidgets rch_rename_dynasty_dialog')]"
			# using = snd_UI_confirm
			using = bg_circle_piechart
		}
	}
}
